# Copy to .env and fill in.  (.env is gitignored.)

# --- MongoDB (required) ---
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_CLUSTER=your-cluster.xxxxx.mongodb.net
USER_NAME=your_name

# --- Model ---
# provider:model string for init_chat_model. Model auth is expected to come from your
# environment (e.g. a LangSmith gateway); leave OPENAI_API_KEY blank if your gateway
# supplies credentials. Do NOT source this file with `set -a` — a blank key here would
# clobber a good one already in your shell.
MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=

# --- LangSmith (optional tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
